# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Subtree-owned artifacts live in the subtree they belong to, not here:
# backend/.gitignore owns Python artifacts (__pycache__/, *.pyc, *.pyo,
# .venv/, .pytest_cache/, backups/) and frontend/.gitignore owns Node
# artifacts (node_modules/, .svelte-kit/, build/, .output/, host deploy dirs,
# vite timestamps). Neither pattern set is repeated below.

# env files
# Applies to backend/ and frontend/ alike; both have real .env files.
.env
.env.*
!.env.example
!.env.test
!.env.demo.example

# misc
*.log

# docker
docker-compose.override.yml
postgres_data/
pgdata/

# ai prompts and agents
docs/developer/prompts
.kilo
