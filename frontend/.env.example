# Copy to .env and fill in. Only PUBLIC_* vars are exposed to the browser.
PUBLIC_API_URL=http://localhost:8000

# Set to true to serve fixtures instead of calling the API (UI work with no
# backend running). Defaults to false — real requests unless explicitly enabled.
PUBLIC_MOCK_MODE=false

# Cloudflare Turnstile site key for the login + forgot-password captcha.
# Empty (default) hides the widget and the backend skips verification;
# set it to enforce captcha (the backend TURNSTILE_SECRET_KEY must also be set).
PUBLIC_TURNSTILE_SITE_KEY=
