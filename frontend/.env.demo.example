# Template for frontend/.env.demo (ignored by .env.*). Copy to .env.demo.
# Run manual dev with: npm run dev -- --mode demo

# Leave empty so the browser uses the current origin and Vite proxies /api.
PUBLIC_API_URL=

# false = real API requests (default).
PUBLIC_MOCK_MODE=false

# Cloudflare Turnstile site key (optional; needs backend TURNSTILE_SECRET_KEY).
PUBLIC_TURNSTILE_SITE_KEY=
# Early-load fallback only; backend /auth/session-policy takes precedence.
PUBLIC_IDLE_TIMEOUT_MINUTES=45
PUBLIC_IDLE_WARNING_MINUTES=5
