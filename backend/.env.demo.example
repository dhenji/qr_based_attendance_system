# Template for backend/.demo.env (gitignored). Copy to .demo.env and fill in.
# Used by docker-compose.demo.yml.

APP_NAME=QR Attendance System API (Demo)
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/attendance_sys
CORS_ORIGINS=http://localhost:5173
# HMAC secret for secure session codes. Generate with: openssl rand -hex 32
HMAC_SECRET_KEY=change-me-to-a-random-hex-string
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# REQUIRED when DEBUG=false. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
PREAUTH_TOKEN_EXPIRE_MINUTES=5
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RECOVERY_TOKEN_EXPIRE_MINUTES=5
LOCKOUT_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
LOCKOUT_ESCALATION_MINUTES=1,5,15,30,60,120
FACE_MATCH_THRESHOLD=0.70
FACE_REVIEW_BAND_LOW=0.65
FACE_EMBEDDING_VERSION=1
FACE_EMBEDDING_ALGORITHM=mediapipe-v1
FACE_EMBEDDING_MODEL=mobilefacenet
MOBILEFACENET_MODEL_PATH=
FACE_EMBEDDING_DIM=512
FACE_INPUT_SIZE=112
FACE_EMBEDDING_NORMALIZE=minus_one_one
GPS_REVIEW_ACCURACY_THRESHOLD=100.0
GPS_HARD_FLOOR_METERS=1000.0
GEOFENCE_UNCERTAINTY_CAP_METERS=50.0
INSTITUTION_TIMEZONE=UTC
DEFAULT_PRESENT_WINDOW_MINUTES=5
DEFAULT_LATE_WINDOW_MINUTES=10
DEFAULT_GEOFENCE_RADIUS_METERS=50
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
BACKUP_STORAGE_TYPE=local
BACKUP_LOCAL_DIR=./backups
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=backups/
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=1
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
BACKUP_EXCLUDE_OTP_CODES=false
BACKUP_COMPRESSION_LEVEL=6
BACKUP_CRON=0 3 * * *
RISK_ABSENCE_RATE_HIGH=0.30
RISK_ABSENCE_RATE_MEDIUM=0.15
RISK_STREAK_GAPS_HIGH=3
RISK_SYNC_LAG_HIGH=5
RISK_TREND_NEGATIVE=-0.05
RISK_BATCH_CRON=0 2 * * *
RISK_BATCH_CHUNK_SIZE=1000
RISK_BATCH_WORKERS=4
RISK_BATCH_DRY_RUN=false
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MISFIRE_GRACE_SECONDS=300
ATTACHMENTS_STORAGE_TYPE=local
ATTACHMENTS_MAX_BYTES=5242880
ATTACHMENTS_LOCAL_DIR=./attachments
# SMTP: fill these in to send real OTP emails during the demo.
# Leave SMTP_HOST empty to fall back to logging (no email sent).
# Example (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_START_TLS=true
# Gmail requires an App Password (enable 2FA first). Port 465 uses implicit TLS
# (SMTP_USE_SSL=true, SMTP_START_TLS=false).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_START_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Cloudflare Turnstile captcha (optional). Empty disables captcha.
# Requires BOTH keys: backend TURNSTILE_SECRET_KEY and frontend
# PUBLIC_TURNSTILE_SITE_KEY. Create a widget in the Cloudflare dashboard
# (free). A secret without the site key rejects every login (400 invalid_captcha).
# Hostnames cannot use wildcards (e.g. *.trycloudflare.com); for quick tunnels
# either disable Turnstile or use a named tunnel with a fixed hostname.
TURNSTILE_SECRET_KEY=
BENCHMARK_MODE=false
SESSION_EARLY_OPEN_MINUTES=30
SESSION_LATE_OPEN_MINUTES=0