FROM python:3.12-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

FROM python:3.12-slim AS runtime

WORKDIR /app

# OpenCV (pulled in by mediapipe / opencv-contrib) needs libGL at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV=/opt/venv

COPY --from=builder /opt/venv /opt/venv
COPY src ./src
# Load-harness helpers live beside src, not inside it: test_locust_discovery
# imports bench_timings (SlotAssigner/discover_session_pool/poisson_wait) and
# reads locustfile.py source text, resolving both via <testdir>/../.. (= /app).
# Baked in as fallback; the api-test Compose mounts override them live.
COPY bench_timings.py locustfile.py ./
# The `api-test` service runs pytest from /app and needs this for
# asyncio_mode and the marker registry; the dev image otherwise has no tests.
COPY pytest.ini ./pytest.ini

EXPOSE 8000

CMD [ "uvicorn", "main:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000", "--reload"]

FROM runtime AS migrate

CMD ["alembic", "upgrade", "head"]
