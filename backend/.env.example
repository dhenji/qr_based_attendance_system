APP_NAME=QR Attendance System API
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/attendance_sys
CORS_ORIGINS=http://localhost:5173
HMAC_SECRET_KEY=
# Comma-separated CIDRs of your load balancer / ingress, when deployed behind
# one. Only then is the leftmost X-Forwarded-For entry trusted for rate-limit
# keys (and only when the direct peer is inside these CIDRs). Leave empty to
# trust nothing — behind a balancer with this empty, every IP-keyed bucket
# collapses onto the balancer's address.
TRUSTED_PROXY_CIDRS=
JWT_SECRET=
JWT_ALGORITHM=HS256
PREAUTH_TOKEN_EXPIRE_MINUTES=5
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RECOVERY_TOKEN_EXPIRE_MINUTES=5
LOCKOUT_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
FACE_MATCH_THRESHOLD=0.70
FACE_REVIEW_BAND_LOW=0.65
FACE_EMBEDDING_VERSION=1
DEFAULT_PRESENT_WINDOW_MINUTES=5
DEFAULT_LATE_WINDOW_MINUTES=10
DEFAULT_GEOFENCE_RADIUS_METERS=50
OTP_EXPIRES_MINUTES=5
BACKUP_STORAGE_TYPE=local
BACKUP_LOCAL_DIR=./backups
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=backups/
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=1
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
BACKUP_EXCLUDE_OTP_CODES=false
BACKUP_COMPRESSION_LEVEL=6
# Nightly full backup. Defaults to 03:00, an hour after RISK_BATCH_CRON so the
# two heavy jobs never overlap. The scheduled run is skipped, and logged as
# CRITICAL, while BACKUP_ENCRYPTION_KEY is empty - so a dev environment does not
# fill backup_log with failed rows every night.
BACKUP_CRON=0 3 * * *
RISK_ABSENCE_RATE_HIGH=0.30
RISK_ABSENCE_RATE_MEDIUM=0.15
RISK_STREAK_GAPS_HIGH=3
RISK_SYNC_LAG_HIGH=5
RISK_TREND_NEGATIVE=-0.05
RISK_BATCH_CRON=0 2 * * *
RISK_BATCH_CHUNK_SIZE=1000
RISK_BATCH_WORKERS=4
RISK_BATCH_DRY_RUN=false
# Background scheduler. Turn SCHEDULER_ENABLED off to run the API with no
# crons at all (dev, or when crons are handled by a separate worker process).
# SCHEDULER_TIMEZONE is a zoneinfo name; an unknown one logs a warning and falls
# back to UTC rather than failing the boot.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MISFIRE_GRACE_SECONDS=300
ATTACHMENTS_STORAGE_TYPE=local
ATTACHMENTS_MAX_BYTES=5242880
# Where the `local` attachment backend writes. Unused when
# ATTACHMENTS_STORAGE_TYPE=s3, which reuses the BACKUP_S3_* bucket.
ATTACHMENTS_LOCAL_DIR=./attachments
# Leave SMTP_HOST empty to disable email: messages are logged instead of sent,
# so OTP codes and excuse notifications never fail a request.
# Port 587 uses STARTTLS (SMTP_START_TLS=true); port 465 uses implicit TLS
# (SMTP_USE_SSL=true, STARTTLS off). SMTP_FROM falls back to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_START_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
TURNSTILE_SECRET_KEY=
BENCHMARK_MODE=false
